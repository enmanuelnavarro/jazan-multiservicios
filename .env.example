# Destino opcional para las solicitudes del formulario de cotización.
# Puede ser un webhook de Kommo CRM, Make, Zapier, n8n o una API propia.
# Si se deja vacío, la solicitud solo se registra en los logs y el cliente
# continúa por WhatsApp.
QUOTE_WEBHOOK_URL=

# URL pública del sitio. En Vercel se puede dejar sin definir: el valor por
# defecto es https://jazan.com.do
NEXT_PUBLIC_SITE_URL=https://jazan.com.do
